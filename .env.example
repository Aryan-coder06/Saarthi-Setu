# Optional for Docker Compose; the app starts without an .env file.
# For local npm development, copy this to .env.local.
# Keep your Sarvam key server-side. Never prefix it with NEXT_PUBLIC_.
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh_enhi_ads
RULE_ENGINE_URL=http://127.0.0.1:3000/api/v1/match
NEXT_PUBLIC_MATCH_URL=/api/match
NEXT_PUBLIC_TRANSCRIBE_URL=/api/transcribe
NEXT_PUBLIC_IVR_VIDEO_URL=
# Docker Compose publishes the web app on this host port by default.
SAARTHI_PORT=3000
